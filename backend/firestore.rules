rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function active(uid) {
      return request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/deletionRequests/$(uid));
    }
    match /users/{uid} {
      allow read, write: if active(uid);
      match /categories/{category} { allow read, write: if active(uid); }
    }
    match /timesheetEntries/{entry} {
      allow read, delete: if active(resource.data.userId);
      allow create: if active(request.resource.data.userId);
      allow update: if active(resource.data.userId)
        && request.resource.data.userId == resource.data.userId;
    }
    // A device can recover an accepted request after a lost callable response.
    match /deletionRequests/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
    // Request mutations, list queries and all unknown paths are server-only.
  }
}
