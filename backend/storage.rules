rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{folder}/{file} {
      function owner() {
        return request.auth != null && request.auth.uid == uid
          && !firestore.exists(/databases/(default)/documents/deletionRequests/$(uid));
      }
      allow read, delete: if owner();
      allow create, update: if owner() && folder in ['images', 'profile_pictures']
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
